# Copy this file to .env before running the API and worker locally.
DATABASE_URL=postgresql+psycopg2://notification:notification@localhost:5432/notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=notifications@example.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAX_DELIVERY_ATTEMPTS=3
WORKER_POLL_SECONDS=2
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio trial only: an HX... predefined Content Template SID from your Console.
TWILIO_TRIAL_CONTENT_SID=
