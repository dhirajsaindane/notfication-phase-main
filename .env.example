# Copy this file to .env before running the API and worker locally.
DATABASE_URL=postgresql+psycopg2://notification:notification@localhost:5432/notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=notifications@example.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAX_DELIVERY_ATTEMPTS=3
WORKER_POLL_SECONDS=2
